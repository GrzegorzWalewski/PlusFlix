// PlusFlix – main window. Uses only custom components from components.slint;
// design values come from theme.slint.
import { Theme } from "theme.slint";
export { Theme }
export { TooltipState }

// Plural form index for a count, per the Polish rules:
//   0 = one   (n == 1)
//   1 = few   (n % 10 in 2..4 and not n % 100 in 12..14)
//   2 = many  (everything else)
// English uses form 0 for n == 1 and form 2 otherwise (its _few keys hold the
// same text as _many so the same expression works in every locale). Select the
// noun key with this form wherever a count is composed into a sentence in
// Slint (see the sources summary); Rust-side strings use `plural_suffix`.
export global PluralForm {
    pure public function form(n: int) -> int {
        if (n == 1) { return 0; }
        if (mod(n, 10) >= 2 && mod(n, 10) <= 4
            && !(mod(n, 100) >= 12 && mod(n, 100) <= 14)) {
            return 1;
        }
        return 2;
    }
}
import {
    Item, ProfileIcon, IconLabel, IconButton, Button, TextField, Select,
    Switch, SegmentedControl, Chip, ProgressBar, PosterCard, CwCard,
    Avatar, VScroll, SearchField, SectionHeader, TooltipLayer, TooltipState,
    KidBadge, AgePicker, PinDialog,
} from "components.slint";
// ListView is the only std-widget used: it is the virtualized list that keeps
// hundreds of grid rows smooth (all visible components stay custom).
import { ListView } from "std-widgets.slint";

export struct NavTab {
    label: string,
    page: string,
}

export struct RowData {
    title: string,
    // Addon/catalog caption shown next to the row title.
    subtitle: string,
    items: [Item],
}

export struct ProfileData {
    id: string,
    name: string,
    icon: string,
    color: color,
    // Child profiles are PIN-gated and carry an age cap (0 = adult/unknown).
    child: bool,
    age: int,
}

export struct EpisodeData {
    id: string,
    label: string,
    thumb: image,
    has-thumb: bool,
    progress: float,
    watched: bool,
}

export struct AddonData {
    name: string,
    kinds: string,
    version: string,
    // "Wait for this addon" switch state (persisted settings).
    waited: bool,
}

// One row of the detail-popup sources list. `status-code` selects the row
// text in Slint: 0 = Ready, 1 = Tried, 2 = Hidden by the profile settings;
// `reason` is the hidden-reason code (see the reject_* keys), 0 = none.
export struct SourceRowData {
    key: string,
    label: string,
    status-code: int,
    reason: int,
}

// One horizontal catalog row with header, edge fades and scroll chevrons.
component CatalogRow inherits Rectangle {
    in property <RowData> data;
    // Translated scroll-chevron tooltips (routed through, never literals).
    in property <string> t-scroll-left;
    in property <string> t-scroll-right;
    callback open(string, string);
    callback remove(string);
    callback toggle-favorite(string, string, string, string); // id, kind, name, poster-url
    callback toggle-watched(string, string); // id, kind
    property <bool> row-hover: ra.has-hover;
    property <length> gap: Theme.sp-4;
    property <int> cols: clamp(floor((self.width + gap) / (150px * Theme.scale + gap)), 4, 12);
    property <length> card-w: (self.width - (cols - 1) * gap) / cols;
    property <bool> is-cw: root.data.items.length > 0 && root.data.items[0].is-cw;
    property <length> header-h: sh.height; // includes the fixed 16px margin below
    property <length> cards-h: is-cw
        ? (card-w * 9 / 16 + Theme.sp-1 + 38px * Theme.scale)
        : (card-w * 1.5 + Theme.sp-1 + 34px * Theme.scale);
    height: header-h + cards-h;
    ra := TouchArea { }
    sh := SectionHeader {
        x: 0;
        y: 0;
        title: root.data.title;
        caption: root.data.subtitle;
    }
    if row-hover && -row-scroll.content-x > 1px: Rectangle {
        x: 0;
        width: Theme.hit;
        height: cards-h;
        y: header-h;
        background: @linear-gradient(90deg, Theme.bg, Colors.transparent);
        IconButton {
            x: Theme.sp-1;
            y: (parent.height - self.height) / 2;
            icon: @image-url("icons/chevron-left.svg");
            tooltip: root.t-scroll-left;
            clicked => {
                row-scroll.content-x = min(0px, row-scroll.content-x + parent.width);
            }
        }
    }
    if row-hover: Rectangle {
        x: parent.width - Theme.hit;
        width: Theme.hit;
        height: cards-h;
        y: header-h;
        background: @linear-gradient(270deg, Theme.bg, Colors.transparent);
        IconButton {
            x: parent.width - self.width - Theme.sp-1;
            y: (parent.height - self.height) / 2;
            icon: @image-url("icons/chevron-right.svg");
            tooltip: root.t-scroll-right;
            clicked => {
                row-scroll.content-x = max(row-scroll.width - row-scroll.content-width, row-scroll.content-x - parent.width);
            }
        }
    }
    row-scroll := Flickable {
        y: header-h;
        height: cards-h;
        content-width: root.data.items.length * (card-w + gap);
        for item[i] in root.data.items: Rectangle {
            x: i * (card-w + gap);
            width: card-w;
            height: parent.height;
            if item.is-cw: CwCard {
                item: item;
                clicked => {
                    root.open(item.title-id == "" ? item.id : item.title-id, item.kind);
                }
                remove(id) => {
                    root.remove(id);
                }
            }
            if !item.is-cw: PosterCard {
                item: item;
                clicked => {
                    root.open(item.title-id == "" ? item.id : item.title-id, item.kind);
                }
                toggle-favorite => {
                    root.toggle-favorite(item.id, item.kind, item.name, item.poster-url);
                }
                toggle-watched => {
                    root.toggle-watched(item.id, item.kind);
                }
            }
        }
    }
}

// Grouped settings card with a heading and rows. The heading is a
// SectionHeader, so its 16px margin below is the only header gap.
component SettingsCard inherits Rectangle {
    in property <string> title;
    background: Theme.surface;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.border;
    vertical-stretch: 0;
    card := VerticalLayout {
        padding: Theme.sp-6;
        spacing: 0px;
        SectionHeader {
            title: root.title;
        }
        VerticalLayout {
            spacing: Theme.sp-4;
            @children
        }
    }
}

// One settings row: label + helper on the left, control(s) on the right.
component SettingsRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> helper;
    VerticalLayout {
        alignment: start;
        spacing: 2px;
        width: 280px * Theme.scale;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.fs-body;
            font-family: Theme.font;
        }
        if root.helper != "": Text {
            text: root.helper;
            color: Theme.muted;
            font-size: Theme.fs-caption;
            font-family: Theme.font;
        }
    }
    Rectangle { horizontal-stretch: 1; }
}

export component MainWindow inherits Window {
    title: "PlusFlix";
    min-width: 1000px;
    min-height: 680px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.bg;
    default-font-family: "Inter";

    // UI scale derived from the window size (reference: 1280x800).
    property <float> win-scale: clamp(min(self.width / 1280px, self.height / 800px), 0.8, 2.5);
    changed win-scale => {
        Theme.scale = self.win-scale;
    }
    init => {
        Theme.scale = self.win-scale;
    }

    // ---- app state ----
    in-out property <string> screen: "login"; // login | profiles | main
    in-out property <string> page: "home"; // home | movies | series | favorites | search | settings
    in property <[NavTab]> nav-tabs;
    in property <[RowData]> rows;
    in property <[Item]> favorites;
    in property <[ProfileData]> profiles;
    in property <bool> can-add-profile;
    in property <string> profile-name;
    in property <string> profile-icon;
    in property <color> profile-color;
    in property <string> status;
    in property <bool> busy;
    in property <[Item]> search-results;
    in property <bool> searching;

    // ---- genre browsing (Movies / Series) ----
    // Genre lists with "All genres" as entry 0, straight from the addon
    // manifests (only genres some catalog really supports). Canonical
    // (English) names: these go back into the addon URLs.
    in property <[string]> movie-genres;
    in property <[string]> series-genres;
    // Parallel display translations of the lists above (same indices), per
    // the interface language; unmapped names fall back to the canonical name.
    in property <[string]> movie-genres-t;
    in property <[string]> series-genres-t;
    // Flat items of the active genre browse; the grid re-rows them.
    in property <[Item]> genre-items;
    // First page in flight: show a skeleton grid.
    in property <bool> genre-busy;
    // Next page in flight: show a spinner row at the end of the grid.
    in property <bool> genre-loading;
    in property <bool> genre-has-more;
    // Catalog chips for the active genre: "All" + catalog display names.
    in property <[string]> genre-catalogs;
    in-out property <int> genre-catalog-idx;
    // Selected genre per page; "" = none (row view is the default).
    // Canonical names in -genre, display translations in -genre-t.
    in-out property <string> movies-genre;
    in-out property <string> series-genre;
    in-out property <string> movies-genre-t;
    in-out property <string> series-genre-t;
    in-out property <bool> genre-popover-open;
    // Highlighted row of the open genre popover (keyboard navigation).
    in-out property <int> genre-popover-idx;
    // Genre strings, translated with the interface language.
    in property <string> t-genres;
    in property <string> t-all-genres;
    in property <string> t-movies-title;
    in property <string> t-series-title;
    in property <string> t-clear-genre;
    in property <string> t-no-genre-prefix;
    in property <string> t-no-genre-suffix;

    // Translated general UI strings (set from Rust via Translations; the
    // scan test fails on any literal not routed through one of these).
    in property <string> t-sign-in;
    in property <string> t-sign-in-subtitle;
    in property <string> t-signing-in;
    in property <string> t-email-placeholder;
    in property <string> t-password-placeholder;
    in property <string> t-whos-watching;
    in property <string> t-manage-profiles;
    in property <string> t-done;
    in property <string> t-edit-or-delete-profiles;
    in property <string> t-log-out;
    in property <string> t-log-out-tooltip;
    in property <string> t-switch-profile;
    in property <string> t-add-profile;
    in property <string> t-add-profile-heading;
    in property <string> t-edit-profile-heading;
    in property <string> t-edit-profile-prefix;
    in property <string> t-switch-to-profile-prefix;
    in property <string> t-profile-name-label;
    in property <string> t-profile-name-placeholder;
    in property <string> t-profile-icon-label;
    in property <string> t-profile-colour-label;
    // Parental controls: child badge, kind toggle, age picker, PIN fields.
    in property <string> t-kid-badge;
    in property <string> t-profile-kind-label;
    in property <string> t-kind-adult;
    in property <string> t-kind-child;
    in property <string> t-age-label;
    in property <string> t-age-lower;
    in property <string> t-age-raise;
    in property <string> t-set-pin-label;
    in property <string> t-set-pin-confirm-label;
    in property <string> t-pin-digits-hint;
    // Parental-PIN dialog (title/prompt/submit; cancel reuses t-cancel).
    in property <string> t-pin-title;
    in property <string> t-pin-prompt;
    in property <string> t-pin-placeholder;
    in property <string> t-pin-submit;
    in property <string> t-save;
    in property <string> t-delete;
    in property <string> t-really-delete;
    in property <string> t-yes-delete;
    in property <string> t-keep;
    in property <string> t-close;
    in property <string> t-loading;
    in property <string> t-nothing-to-show-hint;
    in property <string> t-searching;
    in property <string> t-no-results-hint;
    in property <string> t-no-favorites-hint;
    in property <string> t-favorites-title;
    in property <string> t-search-title;
    in property <string> t-search-placeholder;
    in property <string> t-settings-tooltip;
    in property <string> t-scroll-left;
    in property <string> t-scroll-right;
    in property <string> t-player-section;
    in property <string> t-app-name;

    callback genre-chosen(string);      // "" = clear / "All genres"
    // Genre chip clicked in the detail overlay: (canonical) genre name.
    callback detail-genre-chosen(string);
    callback genre-catalog-chosen(int); // index into genre-catalogs
    callback genre-load-more();          // grid scrolled near the bottom

    // ---- detail overlay ----
    in-out property <bool> detail-open;
    in property <string> detail-id;
    in property <string> detail-title;
    in property <bool> detail-long-title; // true = use the smaller title size
    in property <string> detail-info; // year · runtime (text part of the meta row)
    in property <[string]> detail-genres; // rendered as chips
    // Display translations of detail-genres (same indices); canonical names
    // still go into genre-chosen fired from the chips.
    in property <[string]> detail-genres-t;
    in property <string> detail-desc;
    in property <image> detail-poster;
    in property <bool> detail-has-poster;
    // True while the open meta carries trailer data (Trailer button visibility).
    in property <bool> detail-has-trailer;
    in property <bool> detail-is-series;
    in property <bool> detail-fav;
    in property <[string]> season-names;
    in-out property <int> season-idx;
    in property <[EpisodeData]> episodes;
    in property <string> selected-episode;
    // Sources summary text, composed here (in Slint) from the raw counts and
    // the t-sources-* keys — never a sentence built on the Rust side.
    property <string> sources-summary:
        root.sources-total == 0
            ? (root.sources-state == "loading"
                ? root.t-searching-sources
                : root.t-no-playable-yet)
        : root.sources-usable == 0 && root.sources-state != "loading"
            ? root.t-sources-none-prefix + root.sources-hidden + root.t-sources-none-suffix
        : root.sources-usable
            + " "
            + (PluralForm.form(root.sources-usable) == 0 ? root.t-source-noun-one
                : PluralForm.form(root.sources-usable) == 1 ? root.t-source-noun-few
                : root.t-source-noun-many)
            + (root.sources-hidden > 0
                ? root.t-sources-hidden-prefix + root.sources-hidden
                : "")
            + (root.sources-state == "loading" ? root.t-sources-searching-suffix : "");
    // "loading" | "ready" | "none"
    in property <string> sources-state;
    in property <[SourceRowData]> source-rows;
    in-out property <bool> sources-open;
    // Raw counts for the sources summary chip: the sentence is composed in
    // Slint from the t-sources-* keys (DATA, not sentences, is pushed).
    in property <int> sources-total;
    in property <int> sources-usable;
    in property <int> sources-hidden;
    // Translated sources strings (summary chip + source rows).
    in property <string> t-searching-sources;
    in property <string> t-no-playable-yet;
    in property <string> t-sources-none-prefix;
    in property <string> t-sources-none-suffix;
    in property <string> t-source-noun-one;
    in property <string> t-source-noun-few;
    in property <string> t-source-noun-many;
    in property <string> t-sources-hidden-prefix;
    in property <string> t-sources-searching-suffix;
    in property <string> t-source-ready;
    in property <string> t-source-tried;
    in property <string> t-hidden-prefix;
    in property <string> t-reject-quality;
    in property <string> t-reject-size;
    in property <string> t-reject-audio;
    in property <string> t-reject-subs;

    // ---- playback ----
    in property <bool> playing;
    // True while any "Wait for this addon" addon is still loading:
    // the play buttons read as waiting (not clickable-ready) and the
    // auto-pick gate in Rust defers playback until it lifts.
    in property <bool> waiting-for-addon: false;
    // A gated Play click was received: show the "waiting for more sources"
    // black screen until the watched addons finish (then Rust auto-starts).
    in property <bool> waiting-play: false;
    // Play status composed here (in Slint) from the t-play-* keys plus the
    // raw data pushed by Rust: state enum, source label, switch attempt
    // number and failure reason. Never a sentence built on the Rust side.
    // state: 0 none, 1 starting (first attempt), 2 switching source,
    //        3 playing, 4 skipped, 5 failed, 6 waiting for sources,
    //        7 starting the player
    in property <int> play-state: 0;
    in property <string> play-label: "";
    in property <int> play-attempt: 1;
    in property <string> play-reason: "";
    property <string> play-status-line:
        root.play-state == 1 ? root.t-play-starting-prefix + root.play-label
        : root.play-state == 2
            ? root.t-play-switching-prefix + root.play-attempt + root.t-play-switching-mid + root.play-label
        : root.play-state == 3 ? root.t-playing-prefix + root.play-label
        : root.play-state == 4 ? root.t-skipped-prefix + root.play-label + root.t-skipped-suffix
        : root.play-state == 5
            ? root.t-play-failed-prefix + root.play-label + " (" + root.play-reason + ")"
        : root.play-state == 6 ? root.t-waiting-sources
        : root.play-state == 7 ? root.t-starting-player
        : "";
    // Translated playback strings.
    in property <string> t-starting-player;
    in property <string> t-play-starting-prefix;
    in property <string> t-play-switching-prefix;
    in property <string> t-play-switching-mid;
    in property <string> t-playing-prefix;
    in property <string> t-playing-in-prefix;
    in property <string> t-skipped-prefix;
    in property <string> t-skipped-suffix;
    in property <string> t-play-failed-prefix;
    in property <string> t-waiting-sources;
    in property <string> t-resume;
    in property <string> t-play;
    in property <string> t-resume-playback;
    in property <string> t-choose-player;
    in property <string> t-cancel;
    in property <string> t-next-source;
    in property <string> t-trailer;
    // Translated series strings (episodes header; season display names are
    // rebuilt in Rust from t-season-prefix + the season number).
    in property <string> t-episodes;
    in property <string> t-season-prefix;
    // Translated icon-row tooltips.
    in property <string> t-add-favorites;
    in property <string> t-remove-favorites;
    in property <string> t-mark-watched;
    in property <string> t-mark-unwatched;
    in property <string> t-sources-title;
    in property <bool> can-resume;
    in property <bool> detail-watched;
    in-out property <string> play-player: "mpv"; // "mpv" | "vlc"
    in-out property <bool> player-menu-open: false;
    in property <[string]> player-names;

    // ---- interface language ----
    in-out property <string> app-language: "en";
    in-out property <string> app-language-name: "English";
    // 0 = English, 1 = Polski (Select index of the language dropdown)
    in-out property <int> language-idx;
    // Language dropdown entries; filled from the Rust LANGUAGES table.
    in property <[string]> language-names: [ "English", "Polski" ];

    // ---- profile picker / edit ----
    in-out property <bool> manage-profiles: false;
    in-out property <bool> edit-open: false;
    in-out property <string> edit-id: ""; // empty = creating a new profile
    in-out property <string> edit-name: "";
    in-out property <string> edit-icon: "star";
    in-out property <string> edit-color: "#e5484d";
    // Kind toggle (true = child, PIN-gated profile) + age picker state.
    in-out property <bool> edit-child: false;
    in-out property <int> edit-age: 7;
    // PIN create/confirm pair; the overlay only shows them while a child
    // result would be saved with no PIN set yet.
    in-out property <string> edit-pin: "";
    in-out property <string> edit-pin2: "";
    // Inline validation error of the edit overlay (age / PIN pair).
    in-out property <string> edit-error: "";
    // True while a parental PIN is stored (Rust pushes it; gates the fields).
    in property <bool> pin-set: false;
    in property <[string]> icon-choices;
    in property <[string]> color-choices;
    in property <[color]> color-values;
    in-out property <bool> confirm-del: false;

    // ---- parental PIN dialog ----
    // Opened from Rust (`request_action`) while a PIN-gated action waits.
    in-out property <bool> pin-open: false;
    in-out property <string> pin-entry: "";
    // Wrong-PIN message, set from Rust; empty while no error shows.
    in-out property <string> pin-error: "";

    // ---- settings page ----
    in property <[string]> lang-names;
    in property <[string]> quality-names;
    in-out property <int> audio-idx;
    in-out property <int> audio-mode-idx; // 0 = prefer, 1 = must
    in-out property <int> sub-idx;
    in-out property <int> subreq-idx;
    in-out property <int> minq-idx;
    in-out property <string> max-size;
    // Failover timeouts, in seconds (blank = built-in default: 25 s start,
    // 10 s stall). Set from / saved to the profile settings.
    in-out property <string> start-timeout;
    in-out property <string> stall-timeout;
    in property <[AddonData]> addons;
    in property <bool> refreshing-addons;
    in-out property <int> player-idx;
    // Settings auto-save guard: true while the values are being filled in.
    in-out property <bool> settings-loading: true;
    in property <[string]> subreq-cards;
    in property <[string]> audio-mode-names;

    // Translated settings-page strings (set from Rust via Translations).
    in property <string> t-playback-prefix;
    in property <string> t-audio;
    in property <string> t-pref-audio-label;
    in property <string> t-pref-audio-hint;
    in property <string> t-audio-req-label;
    in property <string> t-audio-req-hint;
    in property <string> t-subtitles;
    in property <string> t-sub-lang-label;
    in property <string> t-sub-req-label;
    in property <string> t-sub-req-hint;
    in property <string> t-quality;
    in property <string> t-minq-label;
    in property <string> t-minq-hint;
    in property <string> t-maxsize-label;
    in property <string> t-maxsize-hint;
    in property <string> t-maxsize-placeholder;
    in property <string> t-failover;
    in property <string> t-start-timeout-label;
    in property <string> t-start-timeout-hint;
    in property <string> t-start-timeout-placeholder;
    in property <string> t-stall-timeout-label;
    in property <string> t-stall-timeout-hint;
    in property <string> t-stall-timeout-placeholder;
    in property <string> t-player-label;
    in property <string> t-player-hint;
    in property <string> t-language;
    in property <string> t-iface-lang-label;
    in property <string> t-iface-lang-hint;
    in property <string> t-addons-prefix;
    in property <string> t-addons-disclaimer;
    in property <string> t-addon-wait-tooltip;
    in property <string> t-refresh;
    in property <string> t-refreshing;

    callback login(string, string);
    callback logout();
    callback select-profile(string);
    callback open-profile-edit(string); // empty id = new profile
    // id, name, icon, color, child kind, child age, PIN create, PIN confirm
    callback save-profile(string, string, string, string, bool, int, string, string);
    callback delete-profile(string);
    // Manage pill: routed through Rust so turning manage ON can be PIN-gated.
    callback toggle-manage();
    // Parental-PIN dialog: submit runs the queued action after a successful
    // check (Rust verifies); cancel / Escape drops it.
    callback submit-pin(string);
    callback cancel-pin();
    callback switch-profile();
    callback navigate(string);
    callback open-item(string, string);
    callback close-detail();
    // Open the open detail meta's trailer in the system default browser.
    callback open-trailer();
    callback toggle-favorite();
    // Card-level toggles fired straight from catalog cards.
    callback toggle-favorite-card(string, string, string, string); // id, kind, name, poster-url
    callback toggle-watched-card(string, string); // id, kind
    callback select-episode(string);
    callback season-changed(int);
    callback play(string); // "mpv" | "vlc" – remembered as the profile's player
    callback play-source(string); // play a specific source picked from the sources list
    callback next-source(); // fail over to the next source during playback
    callback cancel-playback();
    callback remove-progress(string);
    callback toggle-watched();
    callback save-settings();
    callback refresh-addons();
    // (addon name, wait on/off) - toggles the "Wait for this addon" switch
    callback toggle-addon-wait(string, bool);
    callback search(string);
    callback language-changed(int); // new language dropdown index

    // Auto-save: any control change after the initial fill saves once, and
    // the Rust side shows the "Saved" toast.
    function settings-changed() {
        if (!root.settings-loading) {
            root.save-settings();
        }
    }
    changed audio-idx => { root.settings-changed(); }
    changed audio-mode-idx => { root.settings-changed(); }
    changed sub-idx => { root.settings-changed(); }
    changed subreq-idx => { root.settings-changed(); }
    changed minq-idx => { root.settings-changed(); }
    changed max-size => { root.settings-changed(); }
    changed start-timeout => { root.settings-changed(); }
    changed stall-timeout => { root.settings-changed(); }
    changed player-idx => { root.settings-changed(); }
    // Language switching is handled by the language-changed callback (persist +
    // reload translations), not by the settings auto-save.
    changed language-idx => {
        root.language-changed(root.language-idx);
    }

    // ================= login =================
    if root.screen == "login": Rectangle {
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 420px * Theme.scale;
                    height: 380px * Theme.scale;
                    border-radius: Theme.r-md;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: Theme.sp-8;
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text {
                            text: "PlusFlix";
                            font-size: Theme.fs-display;
                            font-weight: 800;
                            color: Theme.accent;
                        }
                        Text {
                            text: root.t-sign-in-subtitle;
                            color: Theme.muted;
                            font-size: Theme.fs-caption;
                        }
                        email := TextField {
                            placeholder-text: root.t-email-placeholder;
                        }
                        pass := TextField {
                            placeholder-text: root.t-password-placeholder;
                            password: true;
                            accepted(text) => {
                                root.login(email.text, pass.text);
                            }
                        }
                        Button {
                            text: root.busy ? root.t-signing-in : root.t-sign-in;
                            primary: true;
                            disabled: root.busy;
                            height: Theme.play-h;
                            clicked => {
                                root.login(email.text, pass.text);
                            }
                        }
                        Text {
                            text: root.status;
                            color: Theme.accent;
                            wrap: word-wrap;
                            font-size: Theme.fs-caption;
                        }
                    }
                }
            }
        }
    }

    // ================= profile picker =================
    if root.screen == "profiles": pw := Rectangle {
        // tile size scales with the window: clamp(120px, 12vw, 200px)
        property <length> tile: clamp(120px * Theme.scale, self.width * 0.12, 200px * Theme.scale);
        VerticalLayout {
            alignment: center;
            spacing: Theme.sp-8;
            Text {
                text: root.manage-profiles ? root.t-manage-profiles : root.t-whos-watching;
                font-size: Theme.fs-display;
                font-weight: 800;
                color: Theme.text;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                spacing: Theme.sp-8;
                for p in root.profiles: VerticalLayout {
                    width: pw.tile;
                    spacing: Theme.sp-3;
                    property <bool> hov: pt.has-hover;
                    Rectangle {
                        height: pw.tile;
                        clip: false;
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: parent.width * (pt.has-hover || root.manage-profiles ? 1.0 : 0.92);
                            height: self.width;
                            border-radius: Theme.r-md;
                            background: p.color;
                            animate x, y, width, height { duration: Theme.t-fast; easing: ease-out; }
                            ProfileIcon {
                                name: p.icon;
                                width: parent.width * 0.48;
                                height: self.width;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                            // Child tiles carry a small "Kid <age>" pill.
                            if p.child: KidBadge {
                                x: Theme.sp-2;
                                y: Theme.sp-2;
                                t-label: root.t-kid-badge;
                                age: p.age;
                            }
                            if root.manage-profiles: Rectangle {
                                width: 36px * Theme.scale;
                                height: 36px * Theme.scale;
                                x: parent.width - self.width - Theme.sp-1;
                                y: parent.height - self.height - Theme.sp-1;
                                border-radius: Theme.r-pill;
                                background: #000000AA;
                                Image {
                                    source: @image-url("icons/pencil.svg");
                                    width: Theme.sp-4;
                                    height: Theme.sp-4;
                                    colorize: white;
                                    image-fit: contain;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                        if pt.has-hover || root.manage-profiles: Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-width: 3px;
                            border-color: white;
                            border-radius: Theme.r-md;
                            background: transparent;
                        }
                        pt := TouchArea {
                            clicked => {
                                if root.manage-profiles {
                                    root.confirm-del = false;
                                    root.open-profile-edit(p.id);
                                } else {
                                    root.select-profile(p.id);
                                }
                            }
                        }
                        accessible-role: button;
                        accessible-label: root.manage-profiles
                            ? root.t-edit-profile-prefix + p.name
                            : root.t-switch-to-profile-prefix + p.name;
                    }
                    Text {
                        width: parent.width;
                        height: self.preferred-height;
                        text: p.name;
                        color: hov ? white : Theme.muted;
                        font-size: Theme.fs-body;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
                if root.can-add-profile && !root.manage-profiles: VerticalLayout {
                    width: pw.tile;
                    spacing: Theme.sp-3;
                    property <bool> hov: at.has-hover;
                    Rectangle {
                        height: pw.tile;
                        clip: false;
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: parent.width * (at.has-hover ? 1.0 : 0.92);
                            height: self.width;
                            border-radius: Theme.r-md;
                            background: Theme.surface-2;
                            border-width: 1.5px;
                            border-color: hov ? white : Theme.border-strong;
                            animate x, y, width, height, border-color { duration: Theme.t-fast; easing: ease-out; }
                            Image {
                                source: @image-url("icons/plus.svg");
                                width: parent.width * 0.4;
                                height: self.width;
                                colorize: hov ? white : Theme.muted;
                                image-fit: contain;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        if at.has-hover: Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-width: 3px;
                            border-color: white;
                            border-radius: Theme.r-md;
                            background: transparent;
                        }
                        at := TouchArea {
                            clicked => {
                                root.confirm-del = false;
                                root.open-profile-edit("");
                            }
                        }
                        accessible-role: button;
                        accessible-label: root.t-add-profile;
                    }
                    Text {
                        width: parent.width;
                        height: self.preferred-height;
                        text: root.t-add-profile;
                        color: Theme.muted;
                        font-size: Theme.fs-body;
                        horizontal-alignment: center;
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Button {
                    outline: !root.manage-profiles;
                    primary: root.manage-profiles;
                    icon: root.manage-profiles ? @image-url("icons/check.svg") : @image-url("icons/pencil.svg");
                    has-icon: true;
                    text: root.manage-profiles ? root.t-done : root.t-manage-profiles;
                    tooltip: root.t-edit-or-delete-profiles;
                    clicked => {
                        // Routed through Rust: manage ON is PIN-gated.
                        root.toggle-manage();
                    }
                }
            }
            Text {
                text: root.status;
                color: Theme.muted;
                font-size: Theme.fs-caption;
                horizontal-alignment: center;
            }
        }
        // Log out: small ghost button in the bottom-right corner
        Button {
            x: parent.width - self.width - Theme.page-margin;
            y: parent.height - self.height - Theme.page-margin;
            ghost: true;
            icon: @image-url("icons/log-out.svg");
            has-icon: true;
            text: root.t-log-out;
            tooltip: root.t-log-out-tooltip;
            clicked => {
                root.logout();
            }
        }

        // ---- edit overlay ----
        if root.edit-open: Rectangle {
            background: Theme.overlay;
            focus-scope := FocusScope {
                width: parent.width;
                height: parent.height;
                init => {
                    self.focus();
                }
                key-pressed(e) => {
                    if (e.text == Key.Escape) {
                        root.edit-open = false;
                        return accept;
                    }
                    return reject;
                }
            }
            Rectangle {
                width: min(parent.width - Theme.sp-12, 560px * Theme.scale);
                height: min(parent.height - Theme.sp-12, 640px * Theme.scale);
                border-radius: Theme.r-md;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                TouchArea { } // swallow clicks so the backdrop doesn't close
                VerticalLayout {
                    padding: Theme.sp-8;
                    spacing: Theme.sp-3;
                    HorizontalLayout {
                        spacing: Theme.sp-2;
                        Text {
                            text: root.edit-id == "" ? root.t-add-profile-heading : root.t-edit-profile-heading;
                            font-size: Theme.fs-title;
                            font-weight: 800;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        IconButton {
                            icon: @image-url("icons/x.svg");
                            tooltip: root.t-close;
                            clicked => {
                                root.edit-open = false;
                            }
                        }
                    }
                    // The form scrolls inside the fixed-height panel: the
                    // kind toggle, age picker and PIN create/confirm fields
                    // made it taller than a single screen-height panel.
                    form-scroll := Flickable {
                        vertical-stretch: 1;
                        content-height: form.preferred-height;
                        form := VerticalLayout {
                            x: 0;
                            width: form-scroll.width;
                            height: max(self.preferred-height, form-scroll.height);
                            spacing: Theme.sp-3;
                            Text {
                                text: root.t-profile-name-label;
                                color: Theme.muted;
                                font-size: Theme.fs-caption;
                            }
                            TextField {
                                text <=> root.edit-name;
                                placeholder-text: root.t-profile-name-placeholder;
                            }
                            Text {
                                text: root.t-profile-icon-label;
                                color: Theme.muted;
                                font-size: Theme.fs-caption;
                            }
                            Flickable {
                                height: ceil(root.icon-choices.length / 5) * 64px * Theme.scale;
                                content-width: 5 * 64px * Theme.scale;
                                content-height: ceil(root.icon-choices.length / 5) * 64px * Theme.scale;
                                for ic[i] in root.icon-choices: Rectangle {
                                    width: 56px * Theme.scale;
                                    height: 56px * Theme.scale;
                                    x: mod(i, 5) * 64px * Theme.scale;
                                    y: floor(i / 5) * 64px * Theme.scale;
                                    border-radius: Theme.r-sm;
                                    background: root.edit-icon == ic ? Theme.accent : Theme.surface-2;
                                    border-width: root.edit-icon == ic ? 3px : 0px;
                                    border-color: white;
                                    ProfileIcon {
                                        name: ic;
                                        width: parent.width * 0.55;
                                        height: self.width;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.edit-icon = ic;
                                        }
                                    }
                                }
                            }
                            Text {
                                text: root.t-profile-colour-label;
                                color: Theme.muted;
                                font-size: Theme.fs-caption;
                            }
                            HorizontalLayout {
                                spacing: Theme.sp-2;
                                alignment: start;
                                for c[i] in root.color-choices: Rectangle {
                                    width: 30px * Theme.scale;
                                    height: 30px * Theme.scale;
                                    border-radius: Theme.r-pill;
                                    background: root.color-values[i];
                                    border-width: root.edit-color == c ? 3px : 0px;
                                    border-color: white;
                                    TouchArea {
                                        clicked => {
                                            root.edit-color = c;
                                        }
                                    }
                                }
                            }
                            // Kind toggle: adult (PIN-free) or child (capped).
                            Text {
                                text: root.t-profile-kind-label;
                                color: Theme.muted;
                                font-size: Theme.fs-caption;
                            }
                            HorizontalLayout {
                                spacing: Theme.sp-2;
                                alignment: start;
                                Button {
                                    text: root.t-kind-adult;
                                    primary: !root.edit-child;
                                    outline: root.edit-child;
                                    clicked => {
                                        root.edit-child = false;
                                    }
                                }
                                Button {
                                    text: root.t-kind-child;
                                    primary: root.edit-child;
                                    outline: !root.edit-child;
                                    clicked => {
                                        root.edit-child = true;
                                    }
                                }
                            }
                            // Age picker: only while the kind toggle says child.
                            if root.edit-child: HorizontalLayout {
                                spacing: Theme.sp-2;
                                alignment: start;
                                Text {
                                    text: root.t-age-label;
                                    color: Theme.muted;
                                    font-size: Theme.fs-caption;
                                    vertical-alignment: center;
                                }
                                AgePicker {
                                    age <=> root.edit-age;
                                    lower-tooltip: root.t-age-lower;
                                    raise-tooltip: root.t-age-raise;
                                }
                            }
                            // PIN create/confirm pair: only while this save
                            // would yield a child profile while no PIN is
                            // set yet (create mode, or an adult→child flip).
                            if root.edit-child && !root.pin-set: VerticalLayout {
                                spacing: Theme.sp-1;
                                Text {
                                    text: root.t-set-pin-label;
                                    color: Theme.muted;
                                    font-size: Theme.fs-caption;
                                }
                                TextField {
                                    text <=> root.edit-pin;
                                    placeholder-text: root.t-pin-placeholder;
                                    password: true;
                                }
                                Text {
                                    text: root.t-set-pin-confirm-label;
                                    color: Theme.muted;
                                    font-size: Theme.fs-caption;
                                }
                                TextField {
                                    text <=> root.edit-pin2;
                                    placeholder-text: root.t-pin-placeholder;
                                    password: true;
                                }
                                Text {
                                    text: root.t-pin-digits-hint;
                                    color: Theme.muted;
                                    font-size: Theme.fs-caption;
                                }
                            }
                            // Age / PIN validation error, set from Rust.
                            if root.edit-error != "": Text {
                                text: root.edit-error;
                                color: Theme.accent;
                                wrap: word-wrap;
                                font-size: Theme.fs-caption;
                            }
                        }
                    }
                    Rectangle { height: Theme.sp-1; }
                    HorizontalLayout {
                        spacing: Theme.sp-2;
                        alignment: start;
                        Button {
                            text: root.t-save;
                            primary: true;
                            clicked => {
                                root.save-profile(root.edit-id, root.edit-name, root.edit-icon, root.edit-color,
                                    root.edit-child, root.edit-age, root.edit-pin, root.edit-pin2);
                            }
                        }
                        if root.edit-id != "" && !root.confirm-del: Button {
                            text: root.t-delete;
                            danger: true;
                            clicked => {
                                root.confirm-del = true;
                            }
                        }
                        if root.edit-id != "" && root.confirm-del: Text {
                            text: root.t-really-delete;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                        if root.edit-id != "" && root.confirm-del: Button {
                            text: root.t-yes-delete;
                            danger: true;
                            clicked => {
                                root.confirm-del = false;
                                root.edit-open = false;
                                root.delete-profile(root.edit-id);
                            }
                        }
                        if root.edit-id != "" && root.confirm-del: Button {
                            text: root.t-keep;
                            clicked => {
                                root.confirm-del = false;
                            }
                        }
                    }
                }
            }
        }

        // ---- parental PIN dialog ----
        // Opened from Rust (`request_action`) while a PIN-gated action
        // waits: submit runs the queued action after a successful PIN
        // check, cancel or Escape drops it.
        if root.pin-open: PinDialog {
            t-title: root.t-pin-title;
            t-prompt: root.t-pin-prompt;
            t-placeholder: root.t-pin-placeholder;
            t-submit: root.t-pin-submit;
            t-cancel: root.t-cancel;
            error-text: root.pin-error;
            entry <=> root.pin-entry;
            submit(pin) => {
                root.submit-pin(pin);
            }
            cancel() => {
                root.cancel-pin();
            }
        }
    }

    // ================= main =================
    if root.screen == "main": Rectangle {
        // ---- catalog pages ----
        if root.page == "home" || root.page == "movies" || root.page == "series": Rectangle {
            // While a genre browse is active on Movies/Series the plain rows
            // are unmounted (not just covered): nothing underneath the genre
            // grid may stay clickable or scrollable.
            if root.page == "home"
                || (root.page == "movies" && root.movies-genre == "")
                || (root.page == "series" && root.series-genre == ""): Rectangle {
            flick := Flickable {
                x: 0;
                width: parent.width - Theme.sp-2;
                height: parent.height;
                content-height: page-content.preferred-height;
                page-content := VerticalLayout {
                    x: 0;
                    width: flick.width;
                    height: max(self.preferred-height, flick.height);
                    padding-left: Theme.page-margin;
                    padding-right: Theme.page-margin;
                    // Movies/Series clear the fixed page header; Home doesn't have one.
                    padding-top: root.page == "home"
                        ? Theme.topbar + Theme.sp-2
                        : Theme.topbar + Theme.sp-2 + Theme.hit + Theme.sp-1;
                    padding-bottom: Theme.sp-6;
                    spacing: Theme.sp-8;
                    if root.busy && root.rows.length == 0: Text {
                        text: root.t-loading;
                        color: Theme.muted;
                        font-size: Theme.fs-body;
                    }
                    if !root.busy && root.rows.length == 0: Text {
                        text: root.t-nothing-to-show-hint;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                    for row in root.rows: CatalogRow {
                        data: row;
                        t-scroll-left: root.t-scroll-left;
                        t-scroll-right: root.t-scroll-right;
                        open(id, kind) => {
                            root.open-item(id, kind);
                        }
                        remove(id) => {
                            root.remove-progress(id);
                        }
                        toggle-favorite(id, kind, name, poster) => {
                            root.toggle-favorite-card(id, kind, name, poster);
                        }
                        toggle-watched(id, kind) => {
                            root.toggle-watched-card(id, kind);
                        }
                    }
                }
            }
            VScroll {
                content-height: page-content.preferred-height;
                viewport-height: parent.height;
                x: parent.width - self.width - 2px * Theme.scale;
                height: parent.height;
                content-y <=> flick.content-y;
            }
            }

            // Fixed page header for Movies / Series (the rows flick clears it
            // via padding-top): title, clear button and the genre pill.
            if root.page != "home": cat-head := Rectangle {
                y: Theme.topbar + Theme.sp-2;
                x: Theme.page-margin;
                width: parent.width - 2 * Theme.page-margin;
                height: Theme.hit;
                // Genre popover data lives here (not on the PopupWindow): a
                // PopupWindow's own properties can't be accessed from outside.
                // `glist` stays canonical (English, straight into the addon
                // URLs); `glist-t` is the same list translated for display.
                property <[string]> glist: root.page == "movies" ? root.movie-genres : root.series-genres;
                property <[string]> glist-t: root.page == "movies" ? root.movie-genres-t : root.series-genres-t;
                property <string> sel-genre: root.page == "movies" ? root.movies-genre : root.series-genre;
                property <string> sel-genre-t: root.page == "movies" ? root.movies-genre-t : root.series-genre-t;
                property <string> page-title: root.page == "movies" ? root.t-movies-title : root.t-series-title;
                // The popup's intended width — the cell grid below derives its
                // column count from THIS, not from cat-head.width (the header
                // spans the whole window, which made every cell huge).
                property <length> gp-w: min(680px * Theme.scale, self.width);
                property <int> gp-cols: clamp(floor(self.gp-w / (170px * Theme.scale)), 3, 4);
                property <length> gp-cell-w: (self.gp-w - 2 * Theme.sp-2) / self.gp-cols;
                HorizontalLayout {
                    Text {
                        text: cat-head.sel-genre == ""
                            ? cat-head.page-title
                            : cat-head.page-title + ": " + cat-head.sel-genre-t;
                        font-size: Theme.fs-heading;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    Rectangle { } // stretch spacer
                    genre-pill := Rectangle {
                        height: 34px * Theme.scale;
                        vertical-stretch: 0;
                        width: Theme.sp-3 + gp-label.preferred-width + Theme.sp-2 + 16px * Theme.scale + Theme.sp-2;
                        border-radius: Theme.r-pill;
                        background: gp-ta.has-hover ? Theme.hover-bg : Theme.surface-2;
                        border-width: 1px;
                        border-color: Theme.border;
                        gp-label := Text {
                            x: Theme.sp-3;
                            y: (parent.height - self.height) / 2;
                            text: cat-head.sel-genre == "" ? root.t-genres : cat-head.sel-genre-t;
                            font-size: Theme.fs-body;
                            color: Theme.text;
                        }
                        Image {
                            source: @image-url("icons/chevron-down.svg");
                            width: 16px * Theme.scale;
                            height: 16px * Theme.scale;
                            colorize: Theme.muted;
                            x: parent.width - Theme.sp-2 - self.width;
                            y: (parent.height - self.height) / 2;
                        }
                        gp-ta := TouchArea {
                            clicked => {
                                root.genre-popover-open = true;
                                gp-popup.show();
                                gp-focus.focus();
                            }
                        }
                        gp-popup := PopupWindow {
                            x: 0;
                            y: parent.height + Theme.sp-2;
                            // PopupWindow sizes via preferred-width/height;
                            // plain width/height bindings are ignored.
                            preferred-width: cat-head.gp-w;
                            preferred-height: 2 * Theme.sp-2 + ceil(cat-head.glist.length / cat-head.gp-cols) * 36px * Theme.scale;
                            Rectangle {
                                // Explicit geometry: a PopupWindow child with
                                // percentage size gets no usable geometry and
                                // the cell TouchAreas never receive clicks
                                // (same lesson as the avatar menu).
                                width: cat-head.gp-w;
                                height: 2 * Theme.sp-2 + ceil(cat-head.glist.length / cat-head.gp-cols) * 36px * Theme.scale;
                                background: #10151CF2;
                                border-width: 1px;
                                border-color: Theme.border-strong;
                                drop-shadow-blur: 40px;
                                drop-shadow-color: #000000C0;
                                for g[i] in cat-head.glist: Rectangle {
                                    // "All genres" is index 0 in both lists;
                                    // match it by index (its display name is
                                    // translated, so a string compare breaks).
                                    property <bool> active: (i == 0 && cat-head.sel-genre == "") || g == cat-head.sel-genre;
                                    x: Theme.sp-2 + mod(i, cat-head.gp-cols) * cat-head.gp-cell-w;
                                    y: Theme.sp-2 + floor(i / cat-head.gp-cols) * 36px * Theme.scale;
                                    width: cat-head.gp-cell-w - Theme.sp-1;
                                    height: 36px * Theme.scale - Theme.sp-1;
                                    border-radius: Theme.r-sm;
                                    background: self.active ? Theme.accent : (gp-cell.has-hover ? Theme.hover-bg : transparent);
                                    Text {
                                        x: Theme.sp-3;
                                        y: (parent.height - self.height) / 2;
                                        // Display translation of the canonical
                                        // name (same index in glist-t).
                                        text: cat-head.glist-t[i];
                                        font-size: Theme.fs-body;
                                        color: parent.active ? #FFFFFF : Theme.text;
                                    }
                                    // TouchArea LAST: earlier siblings (the Text)
                                    // would otherwise sit on top and eat the clicks.
                                    gp-cell := TouchArea {
                                        clicked => {
                                            // Invoke the callback FIRST, close the popup
                                            // LAST: closing (or unmounting) earlier tears
                                            // the item tree down mid-handler and silently
                                            // drops the callback (see tests/avatar_menu.rs).
                                            root.genre-chosen(g == "All genres" ? "" : g);
                                            root.genre-popover-open = false;
                                            gp-popup.close();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Clear button sits to the RIGHT of the pill, with a gap,
                    // both 34px tall so they line up.
                    if cat-head.sel-genre != "": Rectangle {
                        width: Theme.sp-2;
                        height: 34px * Theme.scale;
                        vertical-stretch: 0;
                    }
                    if cat-head.sel-genre != "": IconButton {
                        icon: @image-url("icons/x.svg");
                        tooltip: root.t-clear-genre;
                        height: 34px * Theme.scale;
                        clicked => {
                            root.genre-chosen("");
                        }
                    }
                }
                gp-focus := FocusScope {
                    width: 0px;
                    height: 0px;
                    key-pressed(e) => {
                        if (e.text == Key.Escape) {
                            root.genre-popover-open = false;
                            gp-popup.close();
                            return accept;
                        }
                        if (e.text == Key.Return) {
                            // Callback first, close last (see gp-cell note).
                            if (root.genre-popover-idx == 0) {
                                root.genre-chosen("");
                            } else if (root.genre-popover-idx < cat-head.glist.length) {
                                root.genre-chosen(cat-head.glist[root.genre-popover-idx] == "All genres" ? "" : cat-head.glist[root.genre-popover-idx]);
                            }
                            root.genre-popover-open = false;
                            gp-popup.close();
                            return accept;
                        }
                        if (e.text == Key.LeftArrow) {
                            root.genre-popover-idx = max(0, root.genre-popover-idx - 1);
                            return accept;
                        }
                        if (e.text == Key.RightArrow) {
                            root.genre-popover-idx = min(cat-head.glist.length - 1, root.genre-popover-idx + 1);
                            return accept;
                        }
                        if (e.text == Key.UpArrow) {
                            root.genre-popover-idx = max(0, root.genre-popover-idx - cat-head.gp-cols);
                            return accept;
                        }
                        if (e.text == Key.DownArrow) {
                            root.genre-popover-idx = min(cat-head.glist.length - 1, root.genre-popover-idx + cat-head.gp-cols);
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }

        // ---- genre grid (Movies / Series with an active genre) ----
        // Only the CURRENT page's genre counts: a Movies genre selection must
        // not keep the grid mounted over the Series rows (and vice versa).
        if (root.page == "movies" || root.page == "series") && (root.page == "movies" ? root.movies-genre : root.series-genre) != "": genre-grid := Rectangle {
            // Starts below the fixed page header: cat-head is declared earlier
            // in this file, so a full-size grid would paint right over it.
            y: Theme.topbar + Theme.sp-2 + Theme.hit + Theme.sp-1;
            height: parent.height - self.y;
            property <bool> is-movies: root.page == "movies";
            property <string> sel-genre: is-movies ? root.movies-genre : root.series-genre;
            property <string> sel-genre-t: is-movies ? root.movies-genre-t : root.series-genre-t;
            background: Theme.bg;
            property <int> cols: max(4, floor((self.width - 2 * Theme.page-margin + 24px * Theme.scale) / (150px * Theme.scale + 24px * Theme.scale)));
            property <length> cell-w: (self.width - 2 * Theme.page-margin - (cols - 1) * 24px * Theme.scale) / cols;
            property <length> cell-h: cell-w * 1.5 + Theme.sp-1 + 34px * Theme.scale;
            property <int> row-count: (root.genre-items.length + cols - 1) / cols;
            // y's inside the grid are relative to its origin (below the header).
            property <length> grid-top: Theme.sp-1 + 36px * Theme.scale + Theme.sp-2;

            // catalog chips: "All" + per-addon catalogs, narrowing the active genre
            chips := Flickable {
                y: Theme.sp-1;
                x: 0;
                width: parent.width - Theme.sp-2;
                height: 36px * Theme.scale;
                content-width: chip-row.preferred-width;
                chip-row := HorizontalLayout {
                    x: Theme.page-margin;
                    height: parent.height;
                    alignment: start;
                    spacing: Theme.sp-2;
                    for c[ci] in root.genre-catalogs: chip := Rectangle {
                        property <bool> chosen: root.genre-catalog-idx == ci;
                        height: parent.height;
                        border-radius: Theme.r-pill;
                        background: self.chosen ? Theme.accent : (chip-ta.has-hover ? Theme.hover-bg : Theme.surface-2);
                        border-width: 1px;
                        border-color: self.chosen ? transparent : Theme.border;
                        HorizontalLayout {
                            padding-left: Theme.sp-3;
                            padding-right: Theme.sp-3;
                            Text {
                                text: c;
                                font-size: Theme.fs-caption;
                                vertical-alignment: center;
                                color: chip.chosen ? #FFFFFF : Theme.text;
                            }
                        }
                        chip-ta := TouchArea {
                            clicked => {
                                root.genre-catalog-chosen(ci);
                            }
                        }
                    }
                }
            }

            // skeleton grid while the first page is in flight
            if root.genre-busy && root.genre-items.length == 0: Rectangle {
                x: Theme.page-margin;
                y: genre-grid.grid-top;
                width: parent.width - 2 * Theme.page-margin;
                height: parent.height - self.y;
                for r in 3: Rectangle {
                    for c in genre-grid.cols: Rectangle {
                        x: c * (genre-grid.cell-w + 24px * Theme.scale);
                        y: r * (genre-grid.cell-h + 24px * Theme.scale);
                        width: genre-grid.cell-w;
                        height: genre-grid.cell-h;
                        border-radius: Theme.r-sm;
                        background: #FFFFFF14;
                    }
                }
            }

            // nothing matched (every catalog answered or failed)
            if !root.genre-busy && root.genre-items.length == 0: Rectangle {
                x: Theme.page-margin;
                y: genre-grid.grid-top;
                width: parent.width - 2 * Theme.page-margin;
                height: parent.height - self.y;
                VerticalLayout {
                    padding-top: Theme.sp-12;
                    alignment: start;
                    spacing: Theme.sp-4;
                    Text {
                        text: root.t-no-genre-prefix + genre-grid.sel-genre-t + root.t-no-genre-suffix;
                        wrap: word-wrap;
                        color: Theme.muted;
                        font-size: Theme.fs-body;
                    }
                    Button {
                        text: root.t-clear-genre;
                        primary: true;
                        clicked => {
                            root.genre-chosen("");
                        }
                    }
                }
            }

            // the grid itself: virtualized rows of PosterCards
            if !root.genre-busy && root.genre-items.length > 0: ListView {
                y: genre-grid.grid-top;
                x: 0;
                width: parent.width - Theme.sp-2;
                height: parent.height - self.y;
                for row-idx in genre-grid.row-count: Rectangle {
                    height: genre-grid.cell-h + 24px * Theme.scale;
                    HorizontalLayout {
                        padding-left: Theme.page-margin;
                        padding-right: Theme.page-margin;
                        spacing: 24px * Theme.scale;
                        for ci in genre-grid.cols: cell := Rectangle {
                            property <int> flat: row-idx * genre-grid.cols + ci;
                            property <bool> in-range: flat < root.genre-items.length;
                            width: genre-grid.cell-w;
                            height: genre-grid.cell-h;
                            if in-range: PosterCard {
                                width: parent.width;
                                height: parent.height;
                                item: root.genre-items[cell.flat];
                                clicked => {
                                    root.open-item(self.item.title-id == "" ? self.item.id : self.item.title-id, self.item.kind);
                                }
                                toggle-favorite => {
                                    root.toggle-favorite-card(self.item.id, self.item.kind, self.item.name, self.item.poster-url);
                                }
                                toggle-watched => {
                                    root.toggle-watched-card(self.item.id, self.item.kind);
                                }
                            }
                        }
                    }
                    // Infinite-scroll sentinel: instantiated only when the
                    // ListView builds a near-bottom row (or the grid is short
                    // enough to show one right away) — kicks off the next page.
                    if root.genre-has-more && row-idx >= genre-grid.row-count - 2: Rectangle {
                        width: parent.width;
                        height: 16px * Theme.scale + Theme.sp-1;
                        y: parent.height - self.height - Theme.sp-2;
                        if root.genre-loading: IconLabel {
                            icon: @image-url("icons/rotate-cw.svg");
                            text: "";
                            spin: true;
                            x: (parent.width - self.width) / 2;
                        }
                        init => {
                            root.genre-load-more();
                        }
                    }
                }
            }
        }

        // ---- favorites / search grid ----
        if root.page == "favorites" || root.page == "search": grid-page := Rectangle {
            property <[Item]> grid-items: root.page == "favorites" ? root.favorites : root.search-results;
            property <int> cols: max(4, floor((self.width - 2 * Theme.page-margin + Theme.sp-4) / (160px * Theme.scale + Theme.sp-4)));
            property <length> cell-w: (self.width - 2 * Theme.page-margin - (cols - 1) * Theme.sp-4) / cols;
            property <length> cell-h: cell-w * 1.5 + Theme.sp-1 + 34px * Theme.scale;
            property <length> grid-top: Theme.topbar + Theme.sp-2 + grid-head.height;
            property <length> grid-height: grid-page.grid-top + ceil(grid-page.grid-items.length / grid-page.cols) * (grid-page.cell-h + Theme.sp-4) + Theme.sp-4;
            grid-flick := Flickable {
                x: 0;
                width: parent.width - Theme.sp-2;
                height: parent.height;
                content-height: grid-page.grid-height;
                grid-head := SectionHeader {
                    x: Theme.page-margin;
                    y: Theme.topbar + Theme.sp-2;
                    width: parent.width - Theme.page-margin - Theme.sp-4;
                    title: root.page == "favorites" ? root.t-favorites-title : root.t-search-title;
                }
                if root.page == "search" && root.searching && root.search-results.length == 0: Text {
                    x: Theme.page-margin;
                    y: grid-page.grid-top;
                    text: root.t-searching;
                    color: Theme.muted;
                    font-size: Theme.fs-body;
                }
                if root.page == "search" && !root.searching && root.search-results.length == 0: Text {
                    x: Theme.page-margin;
                    y: grid-page.grid-top;
                    width: parent.width - Theme.page-margin - Theme.sp-4;
                    text: root.t-no-results-hint;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                if root.page == "favorites" && root.favorites.length == 0: Text {
                    x: Theme.page-margin;
                    y: grid-page.grid-top;
                    width: parent.width - Theme.page-margin - Theme.sp-4;
                    text: root.t-no-favorites-hint;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                for item[i] in grid-page.grid-items: PosterCard {
                    width: grid-page.cell-w;
                    height: grid-page.cell-h;
                    x: Theme.page-margin + mod(i, grid-page.cols) * (grid-page.cell-w + Theme.sp-4);
                    y: grid-page.grid-top + floor(i / grid-page.cols) * (grid-page.cell-h + Theme.sp-4);
                    item: item;
                    clicked => {
                        root.open-item(item.title-id == "" ? item.id : item.title-id, item.kind);
                    }
                    toggle-favorite => {
                        root.toggle-favorite-card(item.id, item.kind, item.name, item.poster-url);
                    }
                    toggle-watched => {
                        root.toggle-watched-card(item.id, item.kind);
                    }
                }
            }
            VScroll {
                x: parent.width - self.width - 2px * Theme.scale;
                height: parent.height;
                content-height: grid-page.grid-height;
                viewport-height: parent.height;
                content-y <=> grid-flick.content-y;
            }
        }

        // ---- settings ----
        if root.page == "settings": Rectangle {
            settings-flick := Flickable {
                x: 0;
                width: parent.width - Theme.sp-2;
                height: parent.height;
                content-height: settings-col.preferred-height;
                settings-col := VerticalLayout {
                    x: max((settings-flick.width - 720px * Theme.scale) / 2, Theme.page-margin);
                    width: min(settings-flick.width - 2 * Theme.page-margin, 720px * Theme.scale);
                    height: max(self.preferred-height, settings-flick.height);
                    padding-top: Theme.topbar + Theme.sp-4;
                    padding-bottom: Theme.sp-12;
                    spacing: Theme.sp-4;
                    Text {
                        text: root.t-playback-prefix + root.profile-name;
                        font-size: Theme.fs-title;
                        font-weight: 800;
                        color: Theme.text;
                    }
                    SettingsCard {
                        title: root.t-audio;
                        VerticalLayout {
                            spacing: Theme.sp-4;
                            SettingsRow {
                                label: root.t-pref-audio-label;
                                helper: root.t-pref-audio-hint;
                                Select {
                                    model: root.lang-names;
                                    current-index <=> root.audio-idx;
                                    width: 240px * Theme.scale;
                                }
                            }
                            SettingsRow {
                                label: root.t-audio-req-label;
                                helper: root.t-audio-req-hint;
                                SegmentedControl {
                                    model: root.audio-mode-names;
                                    current-index <=> root.audio-mode-idx;
                                    compact: true;
                                }
                            }
                        }
                    }
                    SettingsCard {
                        title: root.t-subtitles;
                        VerticalLayout {
                            spacing: Theme.sp-4;
                            SettingsRow {
                                label: root.t-sub-lang-label;
                                helper: "";
                                Select {
                                    model: root.lang-names;
                                    current-index <=> root.sub-idx;
                                    width: 240px * Theme.scale;
                                }
                            }
                            SettingsRow {
                                label: root.t-sub-req-label;
                                helper: root.t-sub-req-hint;
                                VerticalLayout {
                                    spacing: Theme.sp-2;
                                    width: 300px * Theme.scale;
                                    for sr[i] in root.subreq-cards: Rectangle {
                                        height: 32px * Theme.scale;
                                        border-radius: Theme.r-sm;
                                        background: root.subreq-idx == i ? Theme.surface-2 : Theme.surface;
                                        border-width: 1px;
                                        border-color: root.subreq-idx == i ? Theme.accent : Theme.border;
                                        animate background, border-color { duration: Theme.t-fast; easing: ease-out; }
                                        HorizontalLayout {
                                            padding-left: Theme.sp-3;
                                            padding-right: Theme.sp-3;
                                            spacing: Theme.sp-2;
                                            Rectangle {
                                                width: 16px * Theme.scale;
                                                height: 16px * Theme.scale;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: Theme.r-pill;
                                                background: transparent;
                                                border-width: root.subreq-idx == i ? 5px : 1.5px;
                                                border-color: root.subreq-idx == i ? Theme.accent : Theme.border-strong;
                                            }
                                            Text {
                                                text: sr;
                                                color: root.subreq-idx == i ? white : Theme.text;
                                                font-size: Theme.fs-caption + 1px * Theme.scale;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            clicked => {
                                                root.subreq-idx = i;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    SettingsCard {
                        title: root.t-quality;
                        VerticalLayout {
                            spacing: Theme.sp-4;
                            SettingsRow {
                                label: root.t-minq-label;
                                helper: root.t-minq-hint;
                                Select {
                                    model: root.quality-names;
                                    current-index <=> root.minq-idx;
                                    width: 240px * Theme.scale;
                                }
                            }
                            SettingsRow {
                                label: root.t-maxsize-label;
                                helper: root.t-maxsize-hint;
                                TextField {
                                    width: 140px * Theme.scale;
                                    text <=> root.max-size;
                                    placeholder-text: root.t-maxsize-placeholder;
                                }
                            }
                        }
                    }
                    SettingsCard {
                        title: root.t-failover;
                        VerticalLayout {
                            spacing: Theme.sp-4;
                            SettingsRow {
                                label: root.t-start-timeout-label;
                                helper: root.t-start-timeout-hint;
                                TextField {
                                    width: 140px * Theme.scale;
                                    text <=> root.start-timeout;
                                    placeholder-text: root.t-start-timeout-placeholder;
                                }
                            }
                            SettingsRow {
                                label: root.t-stall-timeout-label;
                                helper: root.t-stall-timeout-hint;
                                TextField {
                                    width: 140px * Theme.scale;
                                    text <=> root.stall-timeout;
                                    placeholder-text: root.t-stall-timeout-placeholder;
                                }
                            }
                        }
                    }
                    SettingsCard {
                        title: root.t-player-section;
                        VerticalLayout {
                            spacing: Theme.sp-4;
                            SettingsRow {
                                label: root.t-player-label;
                                helper: root.t-player-hint;
                                SegmentedControl {
                                    model: root.player-names;
                                    current-index <=> root.player-idx;
                                }
                            }
                        }
                    }
                    SettingsCard {
                        title: root.t-language;
                        VerticalLayout {
                            spacing: Theme.sp-4;
                            SettingsRow {
                                label: root.t-iface-lang-label;
                                helper: root.t-iface-lang-hint;
                                Select {
                                    model: root.language-names;
                                    current-index <=> root.language-idx;
                                    width: 240px * Theme.scale;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        sh-addons := SectionHeader {
                            title: root.t-addons-prefix + root.addons.length + ")";
                        }
                        Rectangle {
                            height: sh-addons.title-height;
                            horizontal-stretch: 1;
                            Button {
                                x: Theme.sp-4;
                                y: (parent.height - self.height) / 2;
                                text: root.refreshing-addons ? root.t-refreshing : root.t-refresh;
                                icon: @image-url("icons/rotate-cw.svg");
                                has-icon: true;
                                disabled: root.refreshing-addons;
                                clicked => {
                                    root.refresh-addons();
                                }
                            }
                        }
                    }
                    Text {
                        text: root.t-addons-disclaimer;
                        color: Theme.muted;
                        font-size: Theme.fs-caption;
                    }
                    Flickable {
                        height: 220px * Theme.scale;
                        content-height: root.addons.length * 44px * Theme.scale;
                        for a[i] in root.addons: Rectangle {
                            y: i * 44px * Theme.scale;
                            width: parent.width;
                            height: 44px * Theme.scale;
                            border-radius: Theme.r-sm;
                            background: ata.has-hover ? Theme.hover-bg : Theme.surface;
                            // hover highlight only, declared before the layout so
                            // the per-addon Switch below stays clickable (Slint
                            // hit-testing picks the last sibling)
                            ata := TouchArea { }
                            HorizontalLayout {
                                padding-left: Theme.sp-3;
                                padding-right: Theme.sp-3;
                                spacing: Theme.sp-3;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: a.name;
                                        color: Theme.text;
                                        font-size: Theme.fs-body;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: a.kinds;
                                        color: Theme.muted;
                                        font-size: Theme.fs-caption;
                                        overflow: elide;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: a.version;
                                    color: Theme.muted;
                                    font-size: Theme.fs-caption;
                                    vertical-alignment: center;
                                }
                                // "Wait for this addon" switch: on = playback
                                // start (the green/Ready state) waits until this
                                // addon's sources have loaded.
                                Switch {
                                    tooltip: root.t-addon-wait-tooltip;
                                    checked: a.waited;
                                    toggled(checked) => {
                                        root.toggle-addon-wait(a.name, checked);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            VScroll {
                x: parent.width - self.width - 2px * Theme.scale;
                height: parent.height;
                content-height: settings-col.preferred-height;
                viewport-height: parent.height;
                content-y <=> settings-flick.content-y;
            }
        }
        // ---- top bar ----
        Rectangle {
            x: 0;
            y: 0;
            height: Theme.topbar;
            background: @linear-gradient(180deg, Theme.surface, Colors.transparent);
            HorizontalLayout {
                padding-left: Theme.page-margin;
                padding-right: Theme.page-margin;
                spacing: Theme.sp-6;
                Text {
                    text: "PlusFlix";
                    color: Theme.accent;
                    font-size: Theme.fs-heading + Theme.sp-2;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Rectangle { width: Theme.sp-4; }
                for tab in root.nav-tabs: Rectangle {
                    property <bool> act: root.page == tab.page;
                    height: Theme.topbar;
                    width: nt.preferred-width + Theme.sp-6;
                    nt := Text {
                        y: (parent.height - self.height) / 2 - 2px * Theme.scale;
                        height: self.preferred-height;
                        text: tab.label;
                        color: act ? white : Theme.muted;
                        font-size: Theme.fs-body;
                        font-weight: act ? 600 : 400;
                        horizontal-alignment: center;
                        animate color { duration: Theme.t-fast; easing: ease-out; }
                    }
                    if act: Rectangle {
                        y: parent.height - 2px;
                        width: parent.width;
                        height: 2px;
                        background: Theme.accent;
                    }
                    TouchArea {
                        clicked => {
                            root.navigate(tab.page);
                        }
                    }
                    accessible-role: button;
                    accessible-label: tab.label;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            search-box := SearchField {
                y: (parent.height - self.height) / 2;
                x: bar-gear.x - Theme.sp-6 - self.width;
                placeholder-text: root.t-search-placeholder;
                disabled: root.searching;
                submitted(text) => {
                    root.search(text);
                }
            }
            bar-gear := IconButton {
                y: (parent.height - self.height) / 2;
                x: bar-avatar.x - Theme.sp-6 - self.width;
                icon: @image-url("icons/settings.svg");
                tooltip: root.t-settings-tooltip;
                clicked => {
                    root.navigate("settings");
                }
            }
            bar-avatar := Rectangle {
                width: Theme.hit;
                height: Theme.hit;
                x: parent.width - Theme.page-margin - Theme.hit;
                y: (parent.height - Theme.hit) / 2;
                Avatar {
                    width: Theme.sp-8;
                    height: Theme.sp-8;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: root.profile-icon;
                    tint: root.profile-color;
                }
                avatar-open := TouchArea {
                    clicked => {
                        avatar-menu.show();
                    }
                }
                    avatar-menu := PopupWindow {
                        x: -136px * Theme.scale;
                        y: Theme.hit + 4px * Theme.scale;
                        // A PopupWindow sizes itself from preferred-width/height,
                        // not from the child Rectangle's explicit geometry; without
                        // these the menu has no usable geometry and the item
                        // TouchAreas never receive clicks.
                        preferred-width: 180px * Theme.scale;
                        preferred-height: 2 * 40px * Theme.scale + 10px * Theme.scale;
                        Rectangle {
                            width: 180px * Theme.scale;
                            height: 2 * 40px * Theme.scale + 10px * Theme.scale;
                            border-radius: Theme.r-sm;
                            background: Theme.surface-2;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #000000A0;
                            VerticalLayout {
                                padding: 4px * Theme.scale;
                                spacing: 2px * Theme.scale;
                                for mi in [
                                    { label: root.t-switch-profile, icon: @image-url("icons/users.svg"), act: "switch" },
                                    { label: root.t-log-out, icon: @image-url("icons/log-out.svg"), act: "logout" },
                                ]: Rectangle {
                                    height: 40px * Theme.scale;
                                    border-radius: 6px * Theme.scale;
                                    background: ma.has-hover ? Theme.hover-bg : transparent;
                                    animate background { duration: Theme.t-fast; easing: ease-out; }
                                    HorizontalLayout {
                                        padding-left: Theme.sp-3;
                                        IconLabel {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 16px * Theme.scale;
                                            icon: mi.icon;
                                            text: mi.label;
                                            text-size: Theme.fs-caption;
                                            tint: Theme.text;
                                        }
                                    }
                                    ma := TouchArea {
                                        clicked => {
                                            // No explicit `avatar-menu.close()` here: both
                                            // handlers change `screen`, which unmounts the
                                            // `screen == "main"` block that owns this popup,
                                            // so the menu goes away on its own. (Closing the
                                            // popup *before* the callbacks tore the item tree
                                            // down mid-handler and silently dropped the
                                            // callback invocation — see tests/avatar_menu.rs.)
                                            if (mi.act == "switch") {
                                                root.switch-profile();
                                            }
                                            if (mi.act == "logout") {
                                                root.logout();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }

    // ================= detail overlay =================
    if root.detail-open && root.screen == "main": Rectangle {
        background: Theme.overlay;
        TouchArea {
            clicked => {
                root.close-detail();
            }
        }
        detail-fs := FocusScope {
            width: parent.width;
            height: parent.height;
            init => {
                self.focus();
            }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.close-detail();
                    return accept;
                }
                return reject;
            }
        }
        Rectangle {
            width: min(parent.width * 0.88, 1400px * Theme.scale);
            // Movies get a compact card; series fill up with the episode list.
            height: min(parent.height * 0.88, root.detail-is-series ? 900px * Theme.scale : 620px * Theme.scale);
            border-radius: Theme.r-md;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 40px;
            drop-shadow-color: #000000C0;
            TouchArea { } // swallow clicks so the backdrop doesn't close the card
            // absolute positioning: HorizontalLayout child distribution is unreliable here
            // left column: poster, top-aligned, ~30% width
            card-poster := Rectangle {
                    x: Theme.sp-8;
                    y: Theme.sp-8;
                    width: min(parent.width * 0.3, 340px * Theme.scale);
                    height: self.width * 1.5;
                    border-radius: Theme.r-sm;
                    background: Theme.surface-2;
                    clip: true;
                    if root.detail-has-poster: Image {
                        source: root.detail-poster;
                        width: parent.width;
                        height: parent.height;
                        image-fit: cover;
                    }
                }
            // right column: the whole column scrolls (Flickable) — title, meta,
            // description, play row, status chip, episodes/sources and the icon
            // row all live in the viewport, nothing is clipped mid-content.
            card-col := Flickable {
                x: Theme.sp-8 + card-poster.width + Theme.sp-8;
                y: Theme.sp-8;
                width: parent.width - self.x - Theme.sp-8;
                height: parent.height - 2 * Theme.sp-8;
                // 24px breathing room below the last row while scrolling
                content-height: col.preferred-height + 24px * Theme.scale;
                col := VerticalLayout {
                    width: card-col.width;
                    height: max(self.preferred-height, card-col.height - 24px * Theme.scale);
                    spacing: 0px;
                    Text {
                        vertical-stretch: 0;
                        text: root.detail-title;
                        font-size: root.detail-long-title ? Theme.fs-title : Theme.fs-display;
                        font-weight: 800;
                        color: Theme.text;
                        wrap: word-wrap;
                        width: parent.width;
                        height: self.preferred-height;
                    }
                    Rectangle { vertical-stretch: 0; height: Theme.sp-2; }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: Theme.sp-2;
                        alignment: start;
                        height: 24px * Theme.scale;
                        if root.detail-info != "": Text {
                            text: root.detail-info;
                            color: Theme.muted;
                            font-size: Theme.fs-body;
                            vertical-alignment: center;
                            height: parent.height;
                        }
                        for g[gi] in root.detail-genres: Chip {
                            text: root.detail-genres-t[gi];
                            clicked => {
                                // g stays canonical (English): it goes back
                                // into the addon URLs via genre browsing.
                                root.detail-genre-chosen(g);
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 0; height: Theme.sp-3; }
                    // description, ~5 lines then scroll
                    Flickable {
                        width: parent.width;
                        vertical-stretch: 0;
                        height: min(desc.preferred-height, 5 * 27px * Theme.scale);
                        content-height: desc.preferred-height;
                        desc := Text {
                            text: root.detail-desc;
                            font-size: 18px * Theme.scale;
                            color: Theme.text;
                            wrap: word-wrap;
                            width: parent.width;
                        }
                    }
                    Rectangle { vertical-stretch: 0; height: Theme.sp-6; }
                    // Play row: the play split button + the Trailer button
                    // (only when the meta carries trailer data).
                    Rectangle {
                        height: Theme.play-h;
                        play-row := Rectangle {
                            x: 0;
                            height: parent.height;
                            width: pl.width + chev.width + Theme.sp-6;
                            border-radius: Theme.r-pill;
                            // Colour mirrors the cached source resolution, like
                            // the card play pill: green = playable sources ready
                            // (never while a waited-for addon is still loading),
                            // red = nothing playable (ptt is disabled), gray =
                            // still loading / waiting for a watched addon.
                            background: root.playing || root.waiting-for-addon ? Theme.surface-2
                                : root.sources-state == "ready" ? Theme.success
                                : root.sources-state == "none" ? Theme.accent
                                : (ptt.has-hover ? #E8E8ED : white);
                            animate background { duration: Theme.t-fast; easing: ease-out; }
                            clip: true;
                            accessible-role: button;
                            accessible-label: root.can-resume ? root.t-resume-playback : root.t-play;
                            pl := IconLabel {
                                x: Theme.sp-6;
                                y: (parent.height - self.height) / 2;
                                icon-size: Theme.sp-6;
                                icon: @image-url("icons/play.svg");
                                text: root.can-resume ? root.t-resume : root.t-play;
                                text-size: Theme.fs-heading;
                                weight: 600;
                                tint: Theme.on-play;
                            }
                            Rectangle {
                                x: parent.width - chev.width - 1px;
                                y: Theme.sp-3;
                                width: 1px;
                                height: parent.height - 2 * Theme.sp-3;
                                background: Theme.border;
                            }
                            chev := IconButton {
                                x: parent.width - self.width;
                                y: (parent.height - self.height) / 2;
                                tint: Theme.on-play;
                                flat: true;
                                icon: @image-url("icons/chevron-down.svg");
                                tooltip: root.t-choose-player;
                                clicked => {
                                    root.player-menu-open = !root.player-menu-open;
                                }
                            }
                            // click anywhere on the label side of the button
                            ptt := TouchArea {
                                width: parent.width - chev.width;
                                // red state = no playable source: block playback.
                                // waiting-for-addon = a watched addon is still
                                // loading: block the auto-pick (a manual pick
                                // from the source list stays allowed).
                                enabled: !root.playing && root.sources-state != "none" && !root.waiting-for-addon;
                                clicked => {
                                    root.player-menu-open = false;
                                    root.play(root.play-player);
                                }
                            }
                        }
                        // Trailer button: rendered only when the meta carried
                        // trailer data (Rust pushes detail-has-trailer); opens
                        // the YouTube trailer in the system default browser.
                        if root.detail-has-trailer: Button {
                            x: play-row.width + Theme.sp-3;
                            y: (parent.height - self.height) / 2;
                            height: Theme.play-h;
                            text: root.t-trailer;
                            clicked => {
                                root.open-trailer();
                            }
                        }
                        // player picker menu
                        if root.player-menu-open: Rectangle {
                            x: 0px;
                            y: -self.height - 6px * Theme.scale;
                            width: 180px * Theme.scale;
                            height: root.player-names.length * 40px * Theme.scale + 12px * Theme.scale;
                            border-radius: Theme.r-sm;
                            background: Theme.surface-2;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #000000A0;
                            VerticalLayout {
                                padding: 6px * Theme.scale;
                                spacing: 2px * Theme.scale;
                                for pk[i] in root.player-names: Rectangle {
                                    height: 40px * Theme.scale;
                                    border-radius: 6px * Theme.scale;
                                    background: pka.has-hover ? Theme.hover-bg : transparent;
                                    animate background { duration: Theme.t-fast; easing: ease-out; }
                                    HorizontalLayout {
                                        padding-left: Theme.sp-3;
                                        padding-right: Theme.sp-3;
                                        spacing: Theme.sp-2;
                                        Text {
                                            text: pk;
                                            color: Theme.text;
                                            font-size: Theme.fs-body;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        if root.play-player == (i == 0 ? "mpv" : "vlc"): Image {
                                            source: @image-url("icons/check.svg");
                                            width: 15px * Theme.scale;
                                            height: 15px * Theme.scale;
                                            colorize: Theme.accent;
                                            image-fit: contain;
                                            vertical-stretch: 0;
                                        }
                                    }
                                    pka := TouchArea {
                                        clicked => {
                                            root.player-menu-open = false;
                                            root.play(i == 0 ? "mpv" : "vlc");
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 0; height: Theme.sp-3; }
                    // sources status chip (fixed IconLabel keeps spinner + text centered)
                    Rectangle {
                        vertical-stretch: 0;
                        height: 24px * Theme.scale;
                        width: chip-il.width + 2 * Theme.sp-3;
                        border-radius: Theme.r-pill;
                        background: Theme.surface-2;
                        border-width: 1px;
                        border-color: root.sources-state == "none" || root.sources-state == "hidden" ? Theme.warning : Theme.border;
                        chip-il := IconLabel {
                            x: Theme.sp-3;
                            y: (parent.height - self.height) / 2;
                            icon-size: 14px * Theme.scale;
                            icon: @image-url("icons/rotate-cw.svg");
                            spin: root.sources-state == "loading";
                            text: root.sources-summary;
                            text-size: Theme.fs-caption;
                            weight: 400;
                            tint: root.sources-state == "none" || root.sources-state == "hidden" ? Theme.warning : Theme.text;
                        }
                    }
                    // series: episodes header + season selector on ONE row
                    // (header flush left, Select right-aligned)
                    if root.detail-is-series: Rectangle { vertical-stretch: 0; height: Theme.sp-4; }
                    if root.detail-is-series && root.episodes.length > 0: Rectangle {
                        vertical-stretch: 0;
                        height: eps-head.height;
                        eps-head := SectionHeader {
                            title: root.t-episodes;
                        }
                        Select {
                            x: parent.width - self.width;
                            model: root.season-names;
                            current-index <=> root.season-idx;
                            changed current-index => {
                                root.season-changed(self.current-index);
                            }
                            width: 220px * Theme.scale;
                        }
                    }
                    if root.detail-is-series && root.episodes.length > 0 && !root.sources-open: Rectangle { vertical-stretch: 0; height: Theme.sp-3; }
                    if root.detail-is-series && root.episodes.length > 0 && !root.sources-open: Rectangle {
                        // takes all remaining popup height; scrolls, fades at
                        // the bottom, never shows a bare half row without
                        // scroll affordance
                        vertical-stretch: 1;
                        min-height: 200px * Theme.scale;
                        clip: true;
                        ep-flick := Flickable {
                            x: 0;
                            width: parent.width - (ep-scroll.visible ? ep-scroll.width : 0px);
                            height: parent.height;
                            content-height: root.episodes.length * 64px * Theme.scale;
                        for ep[i] in root.episodes: Rectangle {
                            y: i * 64px * Theme.scale;
                            width: parent.width;
                            height: 64px * Theme.scale;
                            border-radius: Theme.r-sm;
                            background: ep.id == root.selected-episode ? Theme.surface-2 : (eta.has-hover ? Theme.hover-bg : transparent);
                            if ep.id == root.selected-episode: Rectangle {
                                x: 0;
                                width: 3px;
                                height: parent.height;
                                border-radius: 2px;
                                background: Theme.accent;
                            }
                            HorizontalLayout {
                                padding-left: Theme.sp-2;
                                padding-right: Theme.sp-3;
                                spacing: Theme.sp-3;
                                Rectangle {
                                    width: 97px * Theme.scale;
                                    height: 54px * Theme.scale;
                                    vertical-stretch: 0;
                                    border-radius: 6px * Theme.scale;
                                    background: Theme.surface-2;
                                    clip: true;
                                    if ep.has-thumb: Image {
                                        source: ep.thumb;
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: cover;
                                    }
                                    // per-episode progress at the bottom of the thumb
                                    if ep.progress > 0: Rectangle {
                                        y: parent.height - 3px * Theme.scale;
                                        width: parent.width * clamp(ep.progress, 0.0, 1.0);
                                        height: 3px * Theme.scale;
                                        background: Theme.accent;
                                    }
                                }
                                Text {
                                    text: ep.label;
                                    color: Theme.text;
                                    font-size: Theme.fs-body;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                if ep.progress > 0 && ep.progress < 1: ProgressBar {
                                    width: 60px * Theme.scale;
                                    progress: ep.progress;
                                    vertical-stretch: 0;
                                }
                                if ep.watched: Image {
                                    source: @image-url("icons/circle-check.svg");
                                    width: Theme.icon;
                                    height: Theme.icon;
                                    colorize: Theme.success;
                                    image-fit: contain;
                                    vertical-stretch: 0;
                                }
                            }
                            eta := TouchArea {
                                clicked => {
                                    root.select-episode(ep.id);
                                }
                            }
                        }
                        }
                        // bottom fade: shows there is more below
                        if ep-flick.content-height > ep-flick.height
                            && -ep-flick.content-y < ep-flick.content-height - ep-flick.height - 1px: Rectangle {
                            x: 0;
                            y: parent.height - 24px * Theme.scale;
                            width: parent.width - (ep-scroll.visible ? ep-scroll.width : 0px);
                            height: 24px * Theme.scale;
                            background: @linear-gradient(180deg, transparent, Theme.surface);
                        }
                        ep-scroll := VScroll {
                            x: parent.width - self.width;
                            height: parent.height;
                            content-height: ep-flick.content-height;
                            viewport-height: ep-flick.height;
                            content-y <=> ep-flick.content-y;
                        }
                    }
                    Rectangle { vertical-stretch: 0; height: Theme.sp-3; }
                    // icon-button row
                    HorizontalLayout {
                        vertical-stretch: 0;
                        padding-top: Theme.sp-1;
                        padding-bottom: Theme.sp-1;
                        spacing: Theme.sp-3;
                        alignment: start;
                        IconButton {
                            icon: root.detail-fav ? @image-url("icons/heart-filled.svg") : @image-url("icons/heart.svg");
                            active: root.detail-fav;
                            tooltip: root.detail-fav ? root.t-remove-favorites : root.t-add-favorites;
                            clicked => {
                                root.toggle-favorite();
                            }
                        }
                        IconButton {
                            icon: @image-url("icons/circle-check.svg");
                            tint: root.detail-watched ? Theme.success : Theme.muted;
                            tooltip: root.detail-watched ? root.t-mark-unwatched : root.t-mark-watched;
                            clicked => {
                                root.toggle-watched();
                            }
                        }
                        IconButton {
                            icon: @image-url("icons/list.svg");
                            tooltip: root.t-sources-title;
                            clicked => {
                                root.sources-open = !root.sources-open;
                            }
                        }
                    }
                    if root.sources-open && root.source-rows.length > 0: Rectangle { vertical-stretch: 0; height: Theme.sp-3; }
                    if root.sources-open && root.source-rows.length > 0: Rectangle {
                        vertical-stretch: 0;
                        height: min(root.source-rows.length * 28px * Theme.scale, 160px * Theme.scale);
                        Flickable {
                            width: parent.width;
                            height: parent.height;
                        content-height: root.source-rows.length * 28px * Theme.scale;
                        for sr[i] in root.source-rows: Rectangle {
                            y: i * 28px * Theme.scale;
                            width: parent.width;
                            height: 28px * Theme.scale;
                            border-radius: 6px * Theme.scale;
                            background: sra.has-hover ? Theme.hover-bg : transparent;
                            HorizontalLayout {
                                padding-left: Theme.sp-2;
                                padding-right: Theme.sp-2;
                                spacing: Theme.sp-2;
                                Text {
                                    text: sr.label;
                                    color: Theme.text;
                                    font-size: Theme.fs-caption;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    // Status composed in Slint from the codes:
                                    // 0 = Ready, 1 = Tried, 2 = Hidden by the
                                    // profile settings (reason 1..4 = which
                                    // setting rejected it, see reject_* keys).
                                    text: sr.status-code == 0 ? root.t-source-ready
                                        : sr.status-code == 1 ? root.t-source-tried
                                        : root.t-hidden-prefix + (sr.reason == 1 ? root.t-reject-quality
                                            : sr.reason == 2 ? root.t-reject-size
                                            : sr.reason == 3 ? root.t-reject-audio
                                            : root.t-reject-subs);
                                    color: sr.status-code == 2 ? Theme.accent : Theme.muted;
                                    font-size: Theme.fs-caption;
                                    vertical-alignment: center;
                                }
                            }
                            sra := TouchArea {
                                enabled: !root.playing;
                                clicked => {
                                    root.play-source(sr.key);
                                }
                            }
                        }
                        }
                    }
                }
            }
            // close button, top-right of the card
            IconButton {
                x: parent.width - self.width - Theme.sp-3;
                y: Theme.sp-3;
                icon: @image-url("icons/x.svg");
                tooltip: root.t-close;
                clicked => {
                    root.close-detail();
                }
            }
        }
    }

    // ================= playing banner =================
    if root.playing: Rectangle {
        background: #000000E6;
        VerticalLayout {
            alignment: center;
            spacing: Theme.sp-2;
            Text {
                text: root.t-playing-in-prefix + (root.play-player == "vlc" ? "VLC" : "mpv");
                color: Theme.text;
                font-size: Theme.fs-title;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: root.play-status-line;
                color: Theme.muted;
                font-size: Theme.fs-body;
                horizontal-alignment: center;
            }
            Rectangle { height: Theme.sp-1; }
            HorizontalLayout {
                alignment: center;
                spacing: Theme.sp-3;
                Button {
                    text: root.t-cancel;
                    icon: @image-url("icons/x.svg");
                    has-icon: true;
                    clicked => {
                        root.cancel-playback();
                    }
                }
                Button {
                    text: root.t-next-source;
                    icon: @image-url("icons/chevron-right.svg");
                    has-icon: true;
                    clicked => {
                        root.next-source();
                    }
                }
            }
        }
    }

    // ================= waiting for more sources =================
    // Shown when Play was clicked while a waited-for addon was still
    // loading: the auto-start (fired by the Rust poll loop once the
    // watched addons finish) clears `waiting-play` and takes over.
    if root.waiting-play && !root.playing: Rectangle {
        background: #000000E6;
        Text {
            text: root.t-waiting-sources;
            color: Theme.text;
            font-size: Theme.fs-title;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }

    // ================= toast =================
    if root.status != "" && root.screen == "main": Rectangle {
        y: parent.height - self.height - Theme.sp-4;
        x: (parent.width - self.width) / 2;
        width: min(parent.width - Theme.sp-8, t.preferred-width + Theme.sp-6);
        height: Theme.hit;
        border-radius: Theme.r-pill;
        background: Theme.surface-2;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 12px;
        drop-shadow-color: #000000A0;
        t := Text {
            text: root.status;
            color: Theme.text;
            font-size: Theme.fs-body;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // The ONE tooltip layer: must be the LAST child of the window so it floats
    // above every popup and is never clipped (see components.slint).
    TooltipLayer {
        window-width: root.width;
        window-height: root.height;
    }
}

// Automated-test window (never shown by the app): hosts representative
// components so layout tests can measure geometry via the testing backend.
export component TestWindow inherits Window {
    width: 900px;
    height: 700px;
    background: Theme.bg;
    in-out property <float> scale: 1.0;
    init => {
        Theme.scale = self.scale;
    }
    changed scale => {
        Theme.scale = self.scale;
    }

    btn-gear := IconButton {
        x: 40px; y: 40px;
        icon: @image-url("icons/settings.svg");
        tooltip: "Gear";
    }
    btn-close := IconButton {
        x: 120px; y: 40px;
        icon: @image-url("icons/x.svg");
        tooltip: "Close";
    }
    btn-labeled := IconButton {
        x: 200px; y: 40px;
        icon: @image-url("icons/heart.svg");
        label: "Fav";
        tooltip: "Fav";
    }
    search-test := SearchField {
        x: 40px; y: 120px;
        placeholder-text: "Search…";
    }
    // Tooltip probes: the button fills TooltipState after the 500 ms hover
    // delay, the single layer renders it (tests/tooltip.rs).
    tip-btn := IconButton {
        x: 760px; y: 40px;
        icon: @image-url("icons/settings.svg");
        tooltip: "Tip";
    }
    tip-layer := TooltipLayer {
        window-width: root.width;
        window-height: root.height;
    }
    card-short := PosterCard {
        x: 40px; y: 220px; width: 150px;
        item: {
            id: "a", kind: "movie", name: "One", year: "",
            poster: @image-url("icons/star.svg"), has-poster: true,
            landscape: @image-url("icons/star.svg"), has-landscape: false,
            title-id: "", episode-label: "", time-left: "",
            progress: 0.0, has-progress: false,
            watched: false, fav: false, is-cw: false,
        };
    }
    card-40 := PosterCard {
        x: 240px; y: 220px; width: 150px;
        item: {
            id: "b", kind: "movie", name: "A forty character title goes right about here!!", year: "",
            poster: @image-url("icons/star.svg"), has-poster: true,
            landscape: @image-url("icons/star.svg"), has-landscape: false,
            title-id: "", episode-label: "", time-left: "",
            progress: 0.0, has-progress: false,
            watched: false, fav: false, is-cw: false,
        };
    }
    card-120 := PosterCard {
        x: 440px; y: 220px; width: 150px;
        item: {
            id: "c", kind: "movie",
            name: "An extremely long one hundred and twenty character title that keeps wrapping and wrapping across many many lines and should never ever change geometry",
            year: "",
            poster: @image-url("icons/star.svg"), has-poster: true,
            landscape: @image-url("icons/star.svg"), has-landscape: false,
            title-id: "", episode-label: "", time-left: "",
            progress: 0.0, has-progress: false,
            watched: false, fav: false, is-cw: false,
        };
    }
    card-noposter := PosterCard {
        x: 640px; y: 220px; width: 150px;
        item: {
            id: "d", kind: "movie", name: "No Poster", year: "",
            poster: @image-url("icons/star.svg"), has-poster: false,
            landscape: @image-url("icons/star.svg"), has-landscape: false,
            title-id: "", episode-label: "", time-left: "",
            progress: 0.0, has-progress: false,
            watched: false, fav: false, is-cw: false,
        };
    }
    cw-test := CwCard {
        x: 40px; y: 460px; width: 240px;
        item: {
            id: "cw", kind: "movie", name: "CW Test", year: "",
            poster: @image-url("icons/star.svg"), has-poster: true,
            landscape: @image-url("icons/star.svg"), has-landscape: true,
            title-id: "", episode-label: "", time-left: "40 min left",
            progress: 0.3, has-progress: true,
            watched: false, fav: false, is-cw: true,
        };
    }

    // Parental-controls fixtures (tests/layout.rs): the PIN dialog opens and
    // closes, the age picker shows for child profiles, child tiles carry the
    // kid badge. The `test-*` properties flip the conditional elements the
    // same way the real overlay state does.
    in-out property <bool> test-pin-open: false;
    in-out property <bool> test-child: false;
    in-out property <int> test-age: 7;
    if root.test-pin-open: pin-dialog-test := PinDialog {
        t-title: "PIN";
        t-prompt: "Enter the PIN.";
        t-placeholder: "PIN";
        t-submit: "OK";
        t-cancel: "Cancel";
        error-text: "";
    }
    if root.test-child: age-picker-test := AgePicker {
        x: 40px;
        y: 620px;
        age <=> root.test-age;
        lower-tooltip: "Down";
        raise-tooltip: "Up";
    }
    if root.test-child: child-badge-test := KidBadge {
        x: 200px;
        y: 620px;
        t-label: "Kid";
        age: 7;
    }
}
